{
  "name": "cafeteria-origen",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"pnpm:dev:backend\" \"pnpm:dev:frontend\"",
    "dev:backend": "pnpm --filter cafeteria-origen-backend dev",
    "dev:frontend": "pnpm --filter cafeteria-origen-frontend dev",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:backend": "pnpm --filter cafeteria-origen-backend build",
    "build:frontend": "pnpm --filter cafeteria-origen-frontend build",
    "test": "pnpm run test:backend && pnpm run test:frontend",
    "test:backend": "pnpm --filter cafeteria-origen-backend test",
    "test:frontend": "pnpm --filter cafeteria-origen-frontend test",
    "test:e2e": "pnpm --filter cafeteria-origen-frontend test:e2e",
    "lint": "pnpm run lint:backend && pnpm run lint:frontend",
    "lint:backend": "pnpm --filter cafeteria-origen-backend lint",
    "lint:frontend": "pnpm --filter cafeteria-origen-frontend lint",
    "format": "pnpm --filter cafeteria-origen-backend format && pnpm --filter cafeteria-origen-frontend format",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.1",
    "@commitlint/config-conventional": "19.6.0",
    "concurrently": "10.0.6",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "prettier": "3.4.2"
  },
  "lint-staged": {
    "backend/src/**/*.ts": [
      "pnpm --filter cafeteria-origen-backend exec eslint --fix",
      "prettier --write"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "frontend/src/**/*.scss": [
      "prettier --write"
    ]
  }
}
